#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
  echo "usage: $0 [build-dir]" >&2
  exit 2
fi

build_dir=${1:-build}

if ! command -v clang-tidy >/dev/null 2>&1; then
  echo "clang-tidy was not found" >&2
  exit 1
fi

if [ ! -f "$build_dir/compile_commands.json" ]; then
  echo "missing $build_dir/compile_commands.json; configure the project first" >&2
  exit 1
fi

jobs=$(nproc 2>/dev/null || echo 4)
if [ "$jobs" -gt 4 ]; then
  jobs=4
fi

file_list=$(mktemp)
tidy_log=$(mktemp)
trap 'rm -f -- "$file_list" "$tidy_log"' EXIT

python3 - "$build_dir/compile_commands.json" > "$file_list" <<'PY'
import json
import os
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    commands = json.load(source)

project_dir = os.path.realpath(os.getcwd())
product_src = os.path.join(project_dir, "product-service", "src")
product_test = os.path.join(project_dir, "product-service", "test")
server_src = os.path.join(project_dir, "sphinxd", "src")
server_test = os.path.join(project_dir, "sphinxd", "test")
required = {
    os.path.join(product_src, name)
    for name in (
        "application/protection/cache_circuit_breaker.cpp",
        "application/ports/product_cache.cpp",
        "bootstrap/product_cache_factory.cpp",
        "application/product_metrics.cpp",
        "backends/redis/redis_product_cache.cpp",
        "domain/product_rules.cpp",
        "application/cache/product_codec.cpp",
        "application/ports/product_store.cpp",
        "application/product_service.cpp",
        "application/protection/product_read_coordinator.cpp",
        "backends/sphinx/sphinx_product_cache.cpp",
        "backends/mysql/mysql_product_store.cpp",
        "http/product_http.cpp",
        "http/product_http_routes.cpp",
        "bootstrap/product_main.cpp",
        "bootstrap/product_config.cpp",
        "bootstrap/product_worker.cpp",
        "backends/mysql/mysql_runtime.cpp",
        "application/cache/product_cache_policy.cpp",
    )
}
required.add(os.path.join(server_test, "client", "cluster_client_test.cpp"))
directories = (server_src, server_test, product_src, product_test)

selected = set()
for command in commands:
    path = command["file"]
    if not os.path.isabs(path):
        path = os.path.join(command["directory"], path)
    path = os.path.realpath(path)
    if any(path.startswith(directory + os.sep) for directory in directories):
        selected.add(path)

missing = sorted(required - selected)
if missing:
    print("compilation database is stale or missing required targets; reconfigure CMake",
          file=sys.stderr)
    for path in missing:
        print(f"  missing: {os.path.relpath(path, project_dir)}", file=sys.stderr)
    sys.exit(2)

for path in sorted(selected):
    print(path, end="\0")
PY

if ! xargs -0 -r -P "$jobs" -n 1 clang-tidy --quiet --config-file=.clang-tidy \
    -p "$build_dir" < "$file_list" > "$tidy_log" 2>&1; then
  cat "$tidy_log" >&2
  exit 1
fi
if grep -q 'error:' "$tidy_log"; then
  cat "$tidy_log" >&2
  exit 1
fi
grep -E ': warning:' "$tidy_log" || true
